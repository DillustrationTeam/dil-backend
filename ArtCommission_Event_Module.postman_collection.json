{
	"info": {
		"_postman_id": "9b12a84c-359f-4bc2-8f19-a1b7e4efc391",
		"name": "ArtCommission - Event & Contest Module",
		"description": "Bộ sưu tập kiểm thử toàn diện cho Module Quản lý Cuộc thi / Sự kiện vẽ (Events, Submissions, Votes, Juries, Invitations).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
