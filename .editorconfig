root = true

# ============================================================
# .editorconfig — dil-backend (dillustration Backend .NET)
# Áp dụng cho TOÀN BỘ thành viên, mọi editor (Visual Studio / VS Code / Rider)
# ============================================================

# Mặc định cho tất cả file
[*]
indent_style = space
indent_size = 4
end_of_line = crlf
charset = utf-8-bom
trim_trailing_whitespace = true
insert_final_newline = true

# C# source files — .NET convention
[*.cs]
indent_size = 4
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = true

# .NET project files
[*.{csproj,sln,props,targets}]
indent_size = 2

# JSON files (appsettings, launch profiles...)
[*.json]
indent_size = 2

# YAML files (GitHub Actions workflows)
[*.{yml,yaml}]
indent_size = 2

# SQL scripts
[*.sql]
indent_size = 4

# Markdown docs
[*.md]
trim_trailing_whitespace = false
insert_final_newline = true
