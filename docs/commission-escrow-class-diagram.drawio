        <mxCell id="commissionDtos" value="&lt;b&gt;&amp;lt;&amp;lt;dto&amp;gt;&amp;gt;&lt;br&gt;Commission DTOs&lt;/b&gt;&lt;hr&gt;CreateCommissionRequest&lt;br&gt;RespondCommissionRequest&lt;br&gt;RespondToCounterofferRequest&lt;br&gt;RequestRevisionRequest&lt;br&gt;CancelWithPolicyRequest&lt;br&gt;CreateDisputeRequest&lt;br&gt;CreateReviewRequest&lt;hr&gt;CommissionDto&lt;br&gt;CommissionDetailDto&lt;br&gt;MilestoneDto&lt;br&gt;DisputeDto&lt;br&gt;ReviewDto" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="125" width="235" height="325" as="geometry"/></mxCell>

