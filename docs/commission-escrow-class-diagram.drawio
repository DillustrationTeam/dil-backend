        <mxCell id="iComm" value="&lt;b&gt;&amp;lt;&amp;lt;interface&amp;gt;&amp;gt;&lt;br&gt;ICommissionService&lt;/b&gt;&lt;hr&gt;+ CreateCommissionAsync&lt;br&gt;+ DepositEscrowAsync&lt;br&gt;+ SubmitMilestoneWipAsync&lt;br&gt;+ ApproveMilestoneAsync&lt;br&gt;+ CancelCommissionAsync&lt;br&gt;+ CreateDisputeAsync" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="50" y="555" width="250" height="240" as="geometry"/></mxCell>
        <mxCell id="commSvc" value="&lt;b&gt;&amp;lt;&amp;lt;service&amp;gt;&amp;gt;&lt;br&gt;CommissionService&lt;/b&gt;&lt;hr&gt;- AppDbContext&lt;br&gt;- IWalletService&lt;br&gt;- IWatermarkService&lt;br&gt;- IStorageService&lt;br&gt;- IVoucherCheckService&lt;br&gt;- INotificationPublisher?&lt;br&gt;- ILogger?&lt;hr&gt;State machine + escrow transaction" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="335" y="555" width="260" height="300" as="geometry"/></mxCell>
