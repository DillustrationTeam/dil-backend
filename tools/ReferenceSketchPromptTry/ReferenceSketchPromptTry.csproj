<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev tool: chạy thử prompt AI Reference Sketch (T03) với Gemini/OpenAI thật.
       Không nằm trong ArtCommission.sln, không deploy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Dùng chung User Secrets với ArtCommission.API -->
    <UserSecretsId>15900198-9ec9-46f9-b125-9585a1e7b901</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ArtCommission.Application\ArtCommission.Application.csproj" />
    <ProjectReference Include="..\..\src\ArtCommission.Infrastructure\ArtCommission.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
